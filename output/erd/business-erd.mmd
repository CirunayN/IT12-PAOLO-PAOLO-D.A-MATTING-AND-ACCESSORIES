---
title: Paolo Paolo - inventory and sales
---
%% Columns from supplied JSON; types / constraints from matching SQL Server migrations.
%% Solid = declared FK. Dashed = application-only reference (not an FK).
erDiagram
    direction LR
    users {
        bigint id PK "bigint; NOT NULL; identity"
        nvarchar name "nvarchar(255); NOT NULL"
        nvarchar username UK "nvarchar(255); NULL"
        nvarchar email UK "nvarchar(255); NOT NULL"
        nvarchar role "nvarchar(255); NOT NULL; default Admin"
        bit is_active "bit; NOT NULL; default 1"
        datetime email_verified_at "datetime; NULL"
        nvarchar password "nvarchar(255); NOT NULL"
        nvarchar remember_token "nvarchar(100); NULL"
        datetime created_at "datetime; NULL"
        datetime updated_at "datetime; NULL"
    }
    tbl_Category {
        bigint ID PK "bigint; NOT NULL; identity"
        nvarchar Name "nvarchar(255); NOT NULL"
        bit Is_Archived "bit; NOT NULL; default 0"
        datetime created_at "datetime; NULL"
        datetime updated_at "datetime; NULL"
    }
    tbl_Status {
        bigint ID PK "bigint; NOT NULL; identity"
        nvarchar Name "nvarchar(255); NOT NULL"
        datetime created_at "datetime; NULL"
        datetime updated_at "datetime; NULL"
    }
    tbl_Payment_Method {
        bigint ID PK "bigint; NOT NULL; identity"
        nvarchar Name "nvarchar(255); NOT NULL"
        datetime created_at "datetime; NULL"
        datetime updated_at "datetime; NULL"
    }
    tbl_Product {
        bigint ID PK "bigint; NOT NULL; identity"
        bigint Category_ID FK "bigint; NOT NULL"
        bigint Status_ID FK "bigint; NOT NULL"
        nvarchar Name "nvarchar(255); NOT NULL"
        nvarchar Description "nvarchar(max); NULL"
        nvarchar Images "nvarchar(max); NULL; JSON image paths"
        nvarchar Image "nvarchar(255); NULL; single image path"
        datetime created_at "datetime; NULL"
        datetime updated_at "datetime; NULL"
    }
    tbl_Stock_in {
        bigint ID PK "bigint; NOT NULL; identity"
        bigint Product_ID FK "bigint; NOT NULL"
        bigint User_ID FK "bigint; NULL"
        decimal Quantity "decimal(10,2); NOT NULL; default 0"
        decimal Remaining_Quantity "decimal(10,2); NOT NULL; default 0; FIFO balance"
        decimal Cost_Price "decimal(10,2); NOT NULL; default 0"
        decimal Retail_Price "decimal(10,2); NOT NULL; default 0"
        bit Has_Expiration "bit; NOT NULL; default 0"
        date Expiration_Date "date; NULL"
        nvarchar Condition "nvarchar(50); NOT NULL; default Good"
        datetime created_at "datetime; NULL"
        datetime updated_at "datetime; NULL"
    }
    tbl_Sale {
        bigint ID PK "bigint; NOT NULL; identity"
        bigint User_ID FK "bigint; NOT NULL"
        bigint Payment_Method_ID FK "bigint; NOT NULL"
        datetime Date "datetime; NOT NULL"
        decimal Total "decimal(10,2); NOT NULL; default 0"
        decimal Amount_Received "decimal(10,2); NOT NULL; default 0"
        decimal Change_Amount "decimal(10,2); NOT NULL; default 0"
        nvarchar GCash_Reference_Number "nvarchar(100); NULL"
        datetime created_at "datetime; NULL"
        datetime updated_at "datetime; NULL"
    }
    tbl_Sold_Item {
        bigint ID PK "bigint; NOT NULL; identity"
        bigint Product_ID FK "bigint; NOT NULL"
        bigint Sale_ID FK "bigint; NOT NULL"
        decimal Quantity "decimal(10,2); NOT NULL; default 1"
        decimal Total "decimal(10,2); NOT NULL; default 0"
        datetime created_at "datetime; NULL"
        datetime updated_at "datetime; NULL"
    }
    tbl_Category ||--o{ tbl_Product : "Category_ID"
    tbl_Status ||--o{ tbl_Product : "Status_ID"
    tbl_Product ||--o{ tbl_Stock_in : "Product_ID"
    users |o--o{ tbl_Stock_in : "User_ID"
    users ||--o{ tbl_Sale : "User_ID"
    tbl_Payment_Method ||--o{ tbl_Sale : "Payment_Method_ID"
    tbl_Product ||--o{ tbl_Sold_Item : "Product_ID"
    tbl_Sale ||--o{ tbl_Sold_Item : "Sale_ID"
